{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "RelWithDebInfo",
      "description": "Everyday build. Homebrew paths are picked up automatically on macOS (cmake/macos-homebrew.cmake); pass -DXRootD_ROOT=... to build libXrdAios.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (warnings are errors)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "AIOS_WERROR": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "AddressSanitizer + UBSan",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "AIOS_SANITIZE": "asan-ubsan",
        "AIOS_WITH_XROOTD": "OFF"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1:abort_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "AIOS_SANITIZE": "tsan",
        "AIOS_WITH_XROOTD": "OFF"
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=0:second_deadlock_stack=1"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 300 }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "inherits": "default"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "inherits": "default",
      "execution": { "timeout": 600 }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "inherits": "default",
      "execution": { "timeout": 600 }
    }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build", "name": "default" },
        { "type": "test", "name": "default" }
      ]
    },
    {
      "name": "ci",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "ci" },
        { "type": "test", "name": "ci" }
      ]
    },
    {
      "name": "asan-ubsan",
      "steps": [
        { "type": "configure", "name": "asan-ubsan" },
        { "type": "build", "name": "asan-ubsan" },
        { "type": "test", "name": "asan-ubsan" }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    }
  ]
}
